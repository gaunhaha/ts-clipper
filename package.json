{
  "name": "ts-clipper",
  "version": "0.1.0",
  "description": "Preview, trim and convert MPEG-TS files to MP4",
  "main": "dist-electron/main.js",
  "type": "module",
  "license": "MIT",
  "author": "MomentX <dev@momentx.co>",
  "scripts": {
    "dev": "concurrently -k -n vite,tsc,el -c blue,yellow,green \"npm:dev:vite\" \"npm:dev:tsc\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:tsc": "node scripts/prepare-electron-out.mjs && tsc -p electron/tsconfig.json --watch",
    "dev:electron": "wait-on tcp:5173 dist-electron/main.js && node scripts/run-electron.mjs",
    "build": "node scripts/prepare-electron-out.mjs && tsc -p electron/tsconfig.json && vite build",
    "package": "npm run build && electron-builder",
    "fetch-binaries": "node scripts/fetch-binaries.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "7zip-bin": "^5.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "co.momentx.ts-clipper",
    "productName": "TS Clipper",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        { "target": "zip", "arch": ["x64"] }
      ],
      "artifactName": "${productName}-${version}-win-x64.${ext}"
    }
  }
}
